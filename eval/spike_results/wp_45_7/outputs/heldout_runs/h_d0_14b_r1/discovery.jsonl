{"arm": "D0", "chunk_id": 21, "digest": "7cdf5a0187d5c58cc5d369b255592f7841d1c4696d45a8c8a9489440385b22f6", "document": "DODI 5200.01", "entry_id": "f9926a2663389efe950c6369", "estimated_prompt_tokens": 1893, "kind": "discovery", "meta": {"done_reason": "stop", "eval_count": 211, "load_duration": 76536111, "prompt_eval_count": 1059, "total_duration": 9729313885, "wall_seconds": 9.736}, "model": "qwen2.5:14b", "num_ctx": 8192, "num_predict": 4096, "prompt_chars": 4731, "prompt_hash": "dae9584ffa32ae9b", "raw_response": "{\"requirements\": [{\"source_quote\": \"Ensure the senior agency official and the senior intelligence official coordinate to achieve a cohesive information security program.\", \"source_ref\": \"\"},\n{\"source_quote\": \"Provide adequate funding and resources to implement classification, declassification, safeguarding, oversight, and security education and training programs.\", \"source_ref\": \"\"},\n{\"source_quote\": \"Establish and maintain an ongoing self-inspection program to include periodic review and assessment of the DoD Component's classified information and CUI products.\", \"source_ref\": \"\"},\n{\"source_quote\": \"Direct and administer a program for systematic declassification reviews as required by subsection 3.4 of Reference (c), to declassify records as soon as possible, but not prematurely, and for review of information subject to the automatic declassification provisions of subsection 3.3 of Reference (c).\", \"source_ref\": \"\"},\n{\"source_quote\": \"Establish and maintain an active security education and training program to inform personnel of their responsibilities for protecting classified information and CUI.\", \"source_ref\": \"\"}]}", "run_label": "h_d0_14b_r1", "status": "complete", "temperature": 0.1, "timestamp": "2026-10-06T02:29:46.748498+00:00"}
